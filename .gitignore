# Regenerable corpora and renders (spec §10)
corpus/
renders/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# PyInstaller staging
packaging/_bin/
packaging/dist/
packaging/build/

# Source documents are never committed: size, and Kenya Law content licensing.
# Operators keep their own copy and pin its sha256 in the corpus meta.
docs/sources/
*.pdf
!tests/fixtures/*.pdf

# Authored Cuts carry the verbatim statutory text they quote. They are the
# reviewable artefacts and belong in an institution's own repository, not in
# this public engine repo, whose NOTICE states that it ships no statutory text.
cuts/*.json

# Brand assets (logos, licensed typefaces) are supplied locally under their own
# licences and must not be redistributed from this public repository.
assets/brand/
*.jpg
*.jpeg
Logo*.png

# OS
Thumbs.db
desktop.ini
.DS_Store

# Generated by hatch-vcs at build time from the git tag.
kifungu/_version.py
